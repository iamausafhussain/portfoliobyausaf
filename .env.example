# Copy this file to `.env` and fill in the values from
# Supabase → Project Settings → API. Both values are public by design
# (security is enforced by Row Level Security in the database).
#
# NEVER put the service_role key or the database password in any env file
# used by the frontend.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# anon / public key
VITE_SUPABASE_ANON_KEY=

# Only used by `npm run db:types` (not by the app). The id is the subdomain of the Project URL.
SUPABASE_PROJECT_ID=
